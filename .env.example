# Sao chép thành .env rồi điền giá trị thật. Không đưa file .env lên GitHub.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lms
# Prisma dùng chuỗi này khi chạy migrate (cùng thông tin như trên)
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/lms"

# API chạy ở cổng 4000; FE (Next.js) chuyển tiếp /api sang đây
PORT=4000
# Địa chỉ FE được phép gọi trực tiếp (phân tách bằng dấu phẩy)
WEB_ORIGIN=http://localhost:3000

# Khoá ký vé mở khu phụ huynh, chuỗi ngẫu nhiên dài ít nhất 32 ký tự
PIN_SECRET=
# PIN 4 số dùng khi chạy npm run db:seed lần đầu (hoặc với --reset-pin)
SEED_PIN=
SEED_CHILD_NAME=Bé
